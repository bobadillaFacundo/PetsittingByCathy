# ============================================================
# VARIABLES DE ENTORNO - BACKEND (PetsittingByCathy)
# ============================================================
# IMPORTANTE: Este archivo NO debe subirse a Git (.gitignore lo excluye).
# Copiá .env.example y completá los valores reales aquí.
# ============================================================


# ╔══════════════════════════════════════════════════════════╗
# ║  1. LOCAL  (desarrollo en esta máquina)                  ║
# ╚══════════════════════════════════════════════════════════╝

# Autenticación JWT — clave para firmar tokens
# Generá una nueva con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Whisper local (fallback STT si no hay GROQ_API_KEY)
# Opciones de modelo: tiny | base | small | medium | large-v2 | large-v3
WHISPER_MODEL=medium


# ╔══════════════════════════════════════════════════════════╗
# ║  2. SERVIDOR REMOTO  (100.82.178.56 via Tailscale)       ║
# ╚══════════════════════════════════════════════════════════╝

# Base de datos PostgreSQL en el servidor remoto (Tailscale)
# Descomentá si querés volver a la BD del servidor propio:
# DATABASE_URL=postgresql://admin:1234@100.82.178.56:5432/veterinary_assistant

# Servidor vLLM (modelo de lenguaje local en el servidor)
# Usá USE_GROQ=0 para que el NLP use este servidor en lugar de Groq
VLLM_BASE_URL=
VLLM_MODEL=

# Qdrant self-hosted en el servidor remoto
# Puerto por defecto de Qdrant: 6333
QDRANT_URL=
# QDRANT_API_KEY=   ← no requerida en self-hosted sin auth


# ╔══════════════════════════════════════════════════════════╗
# ║  3. GROQ  (API cloud — console.groq.com/keys)            ║
# ╚══════════════════════════════════════════════════════════╝

# Clave de API de Groq (requerida para STT y/o NLP con Groq)
GROQ_API_KEY=

# --- Speech-to-Text (STT) ---
# Si GROQ_API_KEY está definida, el STT usa Groq automáticamente.
# Opciones: whisper-large-v3-turbo | whisper-large-v3 | distil-whisper-large-v3-en
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- NLP / Chat ---
# USE_GROQ=1  → usa Groq para el procesamiento de lenguaje (llama / mixtral)
# USE_GROQ=0  → usa el servidor vLLM remoto (100.82.178.56)
USE_GROQ=0
GROQ_MODEL=llama-3.1-8b-instant


# ╔════════════════════════════════════════════════════════╗
# ║  4. QDRANT CLOUD  (cloud.qdrant.io)                      ║
# ╚════════════════════════════════════════════════════════╝

# Si QDRANT_API_KEY está definida, se usa Qdrant Cloud en lugar del servidor remoto.
# URL del cluster en Qdrant Cloud (ej: https://abc123.us-east4-0.gcp.cloud.qdrant.io:6333)

QDRANT_URL=
QDRANT_API_KEY=

# ╔════════════════════════════════════════════════════════╗
# ║  5. SUPABASE  (supabase.com)  ← BASE DE DATOS ACTIVA    ║
# ╚════════════════════════════════════════════════════════╝

# URL pública del proyecto (Settings > API > Project URL)
# SOLO el host del proyecto, sin /rest/v1 ni otros sufijos:
#   https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Clave anónima/pública — se puede exponer en el frontend
# (Settings > API > anon public)
SUPABASE_ANON_KEY=

# Clave de servicio — solo backend, NUNCA exponerla en el frontend
# (Settings > API > service_role secret)
SUPABASE_SERVICE_ROLE_KEY=

# Bucket de Storage para labs/fotos (crear en Supabase → Storage → New bucket)
# Debe ser PUBLIC para que los links "Ver archivo" no expiren.
# Nombre sugerido: uploads  (carpetas internas: labs/, photos/)
SUPABASE_STORAGE_BUCKET=uploads

# Cadena de conexión PostgreSQL de Supabase ← BD activa
#
# ¿Dónde encontrarla?
#   Supabase Dashboard → tu proyecto → botón "Connect" (arriba a la derecha)
#   → pestaña "ORMs"  → copiar la URI de SQLAlchemy  (puerto 6543 - Transaction)
#   → pestaña "Direct connection"  → URI directa        (puerto 5432 - para migraciones)
#
# Puerto 6543 → Transaction pooler (Supavisor) — recomendado para FastAPI/uvicorn
# Puerto 5432 → Directa           — recomendado para alembic / scripts de migración
DATABASE_URL=

# Zona horaria del backend (Argentina)
TZ=America/Argentina/Buenos_Aires

# ╔════════════════════════════════════════════════════════╗
# ║  6. BACKUP AL SERVIDOR PROPIO (cada ~15 días)          ║
# ╚════════════════════════════════════════════════════════╝
# Ver migration/BACKUP.env.example, backup_to_server.py y backup_qdrant_to_chroma.py
# Cron: 0 3 */15 * * .../migration/run_backup.sh
# BACKUP_DIR=
# BACKUP_SOURCE_DATABASE_URL=   # Postgres directo puerto 5432
# BACKUP_KEEP_DB=4
# CHROMA_BACKUP_PATH=           # default: BACKUP_DIR/chroma
# QDRANT_BACKUP_COLLECTIONS=veterinary_reports   # o * para todas

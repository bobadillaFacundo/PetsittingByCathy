<!DOCTYPE html>
<html lang="es">

{{> head}}

<body>
    {{#if (eq tipoUsuario 'admin')}}
    {{> headerAdmin}}
    {{else}}
    {{> headerUser}}
    {{/if}}
    
    <div class="main-content">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12">
                    <!-- Título de la página -->
                    <div class="text-center mb-5">
                        <h2 class="text-white mb-3">
                            <i class="fas fa-paw me-2"></i>
                            Nuestras Mascotas
                        </h2>
                        <p class="text-white-50">Conoce a todos nuestros amigos peludos</p>
                    </div>

                    <!-- Filtros y búsqueda -->
                    <div class="filters-section mb-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="search-box">
                                    <i class="fas fa-search search-icon"></i>
                                    <input type="text" id="searchInput" class="form-control" placeholder="Buscar mascotas...">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select id="tipoFilter" class="form-control">
                                    <option value="">Todos los tipos</option>
                                    {{#each tipos}}
                                    <option value="{{this.nombre}}">{{this.nombre}}</option>
                                    {{/each}}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select id="estadoFilter" class="form-control">
                                    <option value="">Todos los estados</option>
                                    <option value="disponible">Disponible</option>
                                    <option value="enGuarderia">En Guardería</option>
                                    <option value="enAdopcion">En Adopción</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button id="addPetBtn" class="btn btn-primary w-100" onclick="window.location.href='/api/animales/altaAnimal/'">
                                    <i class="fas fa-plus me-2"></i>Agregar
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Lista de mascotas -->
                    <div id="petsContainer">
                        {{#if animales.length}}
                        <div class="row g-4">
                            {{#each animales}}
                            <div class="col-lg-4 col-md-6 col-sm-12 pet-item" 
                                 data-nombre="{{this.nombre}}" 
                                 data-tipo="{{this.tipo}}" 
                                 data-estado="{{#if this.enLaGuarderia}}enGuarderia{{else if this.adopcion}}enAdopcion{{else}}disponible{{/if}}">
                                <div class="pet-card card h-100">
                                    <div class="pet-image-container">
                                        <img src="{{this.foto}}" class="pet-image" alt="Foto de {{this.nombre}}">
                                        <div class="pet-status">
                                            {{#if this.enLaGuarderia}}
                                            <span class="badge bg-primary">
                                                <i class="fas fa-home me-1"></i>En Guardería
                                            </span>
                                            {{else if this.adopcion}}
                                            <span class="badge bg-success">
                                                <i class="fas fa-heart me-1"></i>En Adopción
                                            </span>
                                            {{else}}
                                            <span class="badge bg-info">
                                                <i class="fas fa-check me-1"></i>Disponible
                                            </span>
                                            {{/if}}
                                        </div>
                                    </div>
                                    
                                    <div class="card-body p-4">
                                        <h5 class="card-title text-center mb-3">{{this.nombre}}</h5>
                                        
                                        <div class="pet-details">
                                            <div class="detail-item">
                                                <i class="fas fa-dna text-primary me-2"></i>
                                                <span>Tipo: {{this.tipo}}</span>
                                            </div>
                                            <div class="detail-item">
                                                <i class="fas fa-birthday-cake text-success me-2"></i>
                                                <span>Edad: {{this.edad}} años</span>
                                            </div>
                                            <div class="detail-item">
                                                <i class="fas fa-weight text-warning me-2"></i>
                                                <span>Peso: {{this.peso}} kg</span>
                                            </div>
                                            {{#if this.descripcion}}
                                            <div class="detail-item">
                                                <i class="fas fa-info-circle text-info me-2"></i>
                                                <span>{{this.descripcion}}</span>
                                            </div>
                                            {{/if}}
                                        </div>
                                        
                                        <div class="pet-actions mt-4">
                                            {{#if (eq ../tipoUsuario 'admin')}}
                                            <button class="btn btn-outline-primary btn-sm me-2" onclick="editarAnimal('{{this._id}}')">
                                                <i class="fas fa-edit me-1"></i>Editar
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm me-2" onclick="eliminarAnimal('{{this._id}}')">
                                                <i class="fas fa-trash me-1"></i>Eliminar
                                            </button>
                                            {{else}}
                                            <button class="btn btn-outline-info btn-sm me-2" onclick="verDetalles('{{this._id}}')">
                                                <i class="fas fa-eye me-1"></i>Ver Detalles
                                            </button>
                                            {{/if}}
                                            <button class="btn btn-outline-success btn-sm" onclick="hacerReserva('{{this._id}}')">
                                                <i class="fas fa-calendar me-1"></i>Reservar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                        {{else}}
                        <!-- Mensaje cuando no hay mascotas -->
                        <div class="no-pets-message">
                            <i class="fas fa-paw"></i>
                            <h3>No hay mascotas registradas</h3>
                            <p>Comienza registrando la primera mascota para poder disfrutar de todos nuestros servicios.</p>
                            <div class="mt-4">
                                <button class="btn btn-primary" onclick="window.location.href='/api/animales/altaAnimal/'">
                                    <i class="fas fa-plus me-2"></i>Registrar Primera Mascota
                                </button>
                            </div>
                        </div>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    {{> footer}}
</body>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/listaAnimales.js"></script>
<script src="/js/header.js"></script>
</html>
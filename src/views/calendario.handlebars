<!DOCTYPE html>
<html lang="es">
{{> head}}

<!-- FullCalendar CSS -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.10.0/main.min.css" rel="stylesheet">

<body>
    {{#if (eq tipoUsuario 'admin')}}
    {{> headerAdmin}} 
    {{else}}
    {{> headerUser}}
    {{/if}}
    
    <div class="main-content">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12">
                    <!-- Título del calendario -->
                    <div class="text-center mb-4">
                        <h2 class="text-white mb-3">
                            <i class="fas fa-calendar-alt me-2"></i>
                            Calendario de Reservas
                        </h2>
                        <p class="text-white-50">Gestiona las reservas de tu guardería</p>
                    </div>
                    
                    <!-- Contenedor del calendario -->
                    <div class="calendar-container">
                        <div id="calendar"></div>
                    </div>
                    
                    <!-- Modal para seleccionar el tipo de reserva -->
                    <div id="reservaModal" class="modal-custom">
                        <div class="modal-content-custom">
                            <div class="modal-header-custom">
                                <h3>
                                    <i class="fas fa-plus-circle me-2"></i>
                                    Nueva Reserva
                                </h3>
                            </div>
                            <div class="modal-body-custom">
                                {{#if animales}}
                                <div class="form-group mb-3">
                                    <label for="tipoReserva" class="form-label">
                                        <i class="fas fa-paw me-2"></i>Selecciona tu mascota:
                                    </label>
                                    <select id="tipoReserva" class="form-control">
                                        <option value="">-- Selecciona una mascota --</option>
                                        {{#each animales}}
                                        <option id_animal="{{_id}}" value="{{_id}}">{{nombre}}</option>
                                        {{/each}}
                                    </select>
                                </div>
                                
                                <div class="form-group mb-3">
                                    <label for="alimento" class="form-label">
                                        <i class="fas fa-utensils me-2"></i>Alimento especial:
                                    </label>
                                    <input type="text" id="alimento" class="form-control" placeholder="Ej: Pienso premium, dieta especial...">
                                </div>
                                
                                <div class="form-group mb-3">
                                    <label for="medicamentos" class="form-label">
                                        <i class="fas fa-pills me-2"></i>Medicamentos:
                                    </label>
                                    <input type="text" id="medicamentos" class="form-control" placeholder="Ej: Antibióticos, vitaminas...">
                                </div>
                                
                                <div class="form-group mb-4">
                                    <label for="extras" class="form-label">
                                        <i class="fas fa-star me-2"></i>Extras o notas:
                                    </label>
                                    <textarea id="extras" class="form-control" rows="3" placeholder="Información adicional, cuidados especiales..."></textarea>
                                </div>
                                
                                <div class="modal-actions">
                                    <button id="guardarReserva" class="btn btn-primary">
                                        <i class="fas fa-save me-2"></i>Guardar Reserva
                                    </button>
                                    <button id="cerrarModal" class="btn btn-secondary">
                                        <i class="fas fa-times me-2"></i>Cancelar
                                    </button>
                                </div>
                                {{else}}
                                <!-- Mensaje cuando no hay mascotas -->
                                <div class="no-pets-message">
                                    <i class="fas fa-paw"></i>
                                    <h3>No tienes mascotas registradas</h3>
                                    <p>Para poder hacer una reserva, primero necesitas registrar al menos una mascota en tu perfil.</p>
                                    <div class="mt-4">
                                        <button class="btn btn-primary" onclick="window.location.href='/api/animales/altaAnimal/'">
                                            <i class="fas fa-plus me-2"></i>Registrar Mascota
                                        </button>
                                        <button class="btn btn-outline-light" id="cerrarModal">
                                            <i class="fas fa-times me-2"></i>Cerrar
                                        </button>
                                    </div>
                                </div>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    {{> footer}}
</body>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.9.0/main.min.js"></script>
<script src="/js/calendario.js"></script>
<script src="/js/header.js"></script>
</html>

<!DOCTYPE html>
<html lang="es">
{{> head}}


<body>
    {{#if (eq tipoUsuario 'admin')}}
    {{> headerAdmin}}
    {{else}}
    {{> headerUser}}
    {{/if}}
    <div class="main-content">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <!-- Hero Section -->
                    <div class="hero-section mb-5">
                        <div class="fondo mb-4"></div>
                        <h1 class="display-4 fw-bold text-white mb-3">
                            <i class="fas fa-paw me-3"></i>
                            Bienvenido a Guardería Canina
                        </h1>
                        <p class="lead text-white mb-4">
                            El lugar donde tu mascota recibe el amor y cuidado que se merece
                        </p>
                        <div class="hero-buttons">
                            <button class="btn btn-primary btn-lg me-3" id="btnReservar">
                                <i class="fas fa-calendar-alt me-2"></i>Reservar Ahora
                            </button>
                            <button class="btn btn-outline-light btn-lg" id="btnAdopciones">
                                <i class="fas fa-heart me-2"></i>Ver Adopciones
                            </button>
                        </div>
                    </div>

                    <!-- Features Section -->
                    <div class="row g-4 mb-5">
                        <div class="col-md-4">
                            <div class="feature-card card h-100">
                                <div class="card-body text-center">
                                    <div class="feature-icon mb-3">
                                        <i class="fas fa-home fa-3x text-primary"></i>
                                    </div>
                                    <h5 class="card-title">Hogar Temporal</h5>
                                    <p class="card-text">Tu mascota se sentirá como en casa con nuestras instalaciones cómodas y seguras.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="feature-card card h-100">
                                <div class="card-body text-center">
                                    <div class="feature-icon mb-3">
                                        <i class="fas fa-heartbeat fa-3x text-danger"></i>
                                    </div>
                                    <h5 class="card-title">Cuidado Profesional</h5>
                                    <p class="card-text">Personal capacitado que cuida de la salud y bienestar de tu mascota 24/7.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="feature-card card h-100">
                                <div class="card-body text-center">
                                    <div class="feature-icon mb-3">
                                        <i class="fas fa-users fa-3x text-success"></i>
                                    </div>
                                    <h5 class="card-title">Socialización</h5>
                                    <p class="card-text">Tu mascota podrá interactuar con otros animales en un ambiente controlado.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Services Section -->
                    <div class="services-section mb-5">
                        <h2 class="text-white mb-4">
                            <i class="fas fa-star me-2"></i>Nuestros Servicios
                        </h2>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="service-item card">
                                    <div class="card-body d-flex align-items-center">
                                        <i class="fas fa-bed fa-2x text-primary me-3"></i>
                                        <div>
                                            <h6 class="mb-1">Alojamiento</h6>
                                            <small class="text-muted">Espacios cómodos y limpios</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="service-item card">
                                    <div class="card-body d-flex align-items-center">
                                        <i class="fas fa-utensils fa-2x text-warning me-3"></i>
                                        <div>
                                            <h6 class="mb-1">Alimentación</h6>
                                            <small class="text-muted">Dieta balanceada y nutritiva</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="service-item card">
                                    <div class="card-body d-flex align-items-center">
                                        <i class="fas fa-walking fa-2x text-success me-3"></i>
                                        <div>
                                            <h6 class="mb-1">Ejercicio</h6>
                                            <small class="text-muted">Paseos y actividades recreativas</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="service-item card">
                                    <div class="card-body d-flex align-items-center">
                                        <i class="fas fa-shower fa-2x text-info me-3"></i>
                                        <div>
                                            <h6 class="mb-1">Higiene</h6>
                                            <small class="text-muted">Baños y cuidados especiales</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Call to Action -->
                    <div class="cta-section">
                        <div class="card bg-primary text-white">
                            <div class="card-body text-center p-5">
                                <h3 class="mb-3">
                                    <i class="fas fa-phone me-2"></i>¿Tienes preguntas?
                                </h3>
                                <p class="mb-4">Nuestro equipo está listo para ayudarte a encontrar el mejor cuidado para tu mascota.</p>
                                <button class="btn btn-light btn-lg" id="btnPerfil">
                                    <i class="fas fa-user me-2"></i>Contactar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
      {{> footer }}
</body>

</html>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/header.js"></script>
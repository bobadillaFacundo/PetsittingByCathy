<!DOCTYPE html>
<html lang="es">
{{> head}}

<body>
    {{#if (eq tipoUsuario 'admin')}}
    {{> headerAdmin}}
    {{else}}
    {{> headerUser}}
    {{/if}}
    
    <div class="main-content">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12">
                    <!-- Título de la página -->
                    <div class="text-center mb-5">
                        <h2 class="text-white mb-3">
                            <i class="fas fa-user-circle me-2"></i>
                            Mi Perfil
                        </h2>
                        <p class="text-white-50">Gestiona tu información personal y mascotas</p>
                    </div>

                    <div class="row g-4">
                        <!-- Perfil del usuario -->
                        <div class="col-lg-4">
                            <div class="profile-card card h-100">
                                <div class="card-body text-center p-4">
                                    <div class="profile-avatar mb-4">
                                        <div class="avatar-container">
                                            <img src="{{usuario.foto}}" class="profile-image" alt="Foto del usuario">
                                            <div class="avatar-overlay">
                                                <i class="fas fa-camera"></i>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <h4 class="card-title mb-3">{{usuario.nombre}}</h4>
                                    
                                    <div class="profile-info">
                                        <div class="info-item mb-3">
                                            <i class="fas fa-envelope text-primary me-2"></i>
                                            <span>{{usuario.email}}</span>
                                        </div>
                                        
                                        <div class="info-item mb-3">
                                            <i class="fas fa-calendar-alt text-success me-2"></i>
                                            <span>Miembro desde {{usuario.fechaCreacion}}</span>
                                        </div>
                                        
                                        <div class="info-item mb-4">
                                            <i class="fas fa-paw text-warning me-2"></i>
                                            <span>{{usuario.animales.length}} mascota{{#unless (eq usuario.animales.length 1)}}s{{/unless}}</span>
                                        </div>
                                    </div>
                                    
                                    <div class="profile-actions">
                                        <button class="btn btn-primary btn-sm me-2">
                                            <i class="fas fa-edit me-1"></i>Editar Perfil
                                        </button>
                                        <button class="btn btn-outline-secondary btn-sm">
                                            <i class="fas fa-cog me-1"></i>Configuración
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Carrusel de animales -->
                        <div class="col-lg-8">
                            <div class="pets-section">
                                <div class="section-header mb-4">
                                    <h3 class="text-white mb-2">
                                        <i class="fas fa-paw me-2"></i>
                                        Mis Mascotas
                                    </h3>
                                    <p class="text-white-50">Tus compañeros peludos</p>
                                </div>

                                {{#if usuario.animales.length}}
                                <div id="carruselAnimales" class="carousel slide pets-carousel" data-bs-ride="carousel">
                                    <div class="carousel-indicators">
                                        {{#each usuario.animales}}
                                        <button type="button" data-bs-target="#carruselAnimales" 
                                                data-bs-slide-to="{{@index}}" 
                                                class="{{#if @first}}active{{/if}}"></button>
                                        {{/each}}
                                    </div>
                                    
                                    <div class="carousel-inner">
                                        {{#each usuario.animales}}
                                        <div class="carousel-item {{#if @first}}active{{/if}}">
                                            <div class="pet-card card h-100">
                                                <div class="card-body p-4">
                                                    <div class="pet-image-container mb-3">
                                                        <img src="{{this.foto}}" class="pet-image" alt="Foto de {{nombre}}">
                                                        <div class="pet-status">
                                                            {{#if enLaGuarderia}}
                                                            <span class="badge bg-primary">
                                                                <i class="fas fa-home me-1"></i>En Guardería
                                                            </span>
                                                            {{/if}}
                                                            {{#if adopcion}}
                                                            <span class="badge bg-success">
                                                                <i class="fas fa-heart me-1"></i>En Adopción
                                                            </span>
                                                            {{/if}}
                                                        </div>
                                                    </div>
                                                    
                                                    <h5 class="card-title text-center mb-3">{{this.nombre}}</h5>
                                                    
                                                    <div class="pet-details">
                                                        <div class="detail-item">
                                                            <i class="fas fa-dna text-primary me-2"></i>
                                                            <span>Tipo: {{this.tipo}}</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <i class="fas fa-birthday-cake text-success me-2"></i>
                                                            <span>Edad: {{this.edad}} años</span>
                                                        </div>
                                                        <div class="detail-item">
                                                            <i class="fas fa-weight text-warning me-2"></i>
                                                            <span>Peso: {{this.peso}} kg</span>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="pet-actions mt-4">
                                                        <button class="btn btn-outline-primary btn-sm me-2">
                                                            <i class="fas fa-edit me-1"></i>Editar
                                                        </button>
                                                        <button class="btn btn-outline-info btn-sm me-2">
                                                            <i class="fas fa-calendar me-1"></i>Reservar
                                                        </button>
                                                        <button class="btn btn-outline-success btn-sm">
                                                            <i class="fas fa-heart me-1"></i>Adoptar
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        {{/each}}
                                    </div>
                                    
                                    <button class="carousel-control-prev" type="button" data-bs-target="#carruselAnimales" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon"></span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#carruselAnimales" data-bs-slide="next">
                                        <span class="carousel-control-next-icon"></span>
                                    </button>
                                </div>
                                {{else}}
                                <!-- Mensaje cuando no hay mascotas -->
                                <div class="no-pets-message">
                                    <i class="fas fa-paw"></i>
                                    <h3>No tienes mascotas registradas</h3>
                                    <p>Comienza registrando tu primera mascota para poder disfrutar de todos nuestros servicios.</p>
                                    <div class="mt-4">
                                        <button class="btn btn-primary" onclick="window.location.href='/api/animales/altaAnimal/'">
                                            <i class="fas fa-plus me-2"></i>Registrar Primera Mascota
                                        </button>
                                    </div>
                                </div>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    {{> footer}}
</body>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/viewPerfilUsuario.js"></script>
<script src="/js/header.js"></script>
</html>
{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://petsittingbycathy.onrender.com/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://petsittingbycathy.onrender.com/health/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://petsittingbycathy.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads|health|assets|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

# Backup periódico (servidor propio vía SSH)
# ============================================================
# Copia cada ~15 días:
# - Supabase → carpeta local (BD completa + Storage incremental)
# - Qdrant → ChromaDB local (colecciones vectoriales)
#
# En el servidor:
#   apt install postgresql-client   # para pg_dump
#   pip install -r migration/requirements.txt
#   chmod +x migration/run_backup.sh
#   python migration/backup_to_server.py          # prueba BD/storage
#   python migration/backup_qdrant_to_chroma.py   # prueba vectores
#
# Cron (cada 15 días a las 03:00):
#   0 3 */15 * * /ruta/PetsittingByCathy/migration/run_backup.sh >> /var/log/petsitting_backup.log 2>&1
#
# Carpeta resultante (BACKUP_DIR):
#   backups/petsitting/
#     db/petsitting_YYYYMMDD_HHMMSS.sql.gz
#     db/petsitting_latest.sql.gz
#     storage/labs/...
#     storage/photos/...
#     chroma/                          ← ChromaDB persistente (desde Qdrant)
#     LAST_BACKUP.txt
#     LAST_QDRANT_BACKUP.txt

# Destino en el servidor
BACKUP_DIR=

# Postgres DIRECTO de Supabase (Settings → Database → URI, puerto 5432)
# No uses el pooler 6543 para pg_dump
BACKUP_SOURCE_DATABASE_URL=

# --- Qdrant → Chroma ---
# Por defecto usa QDRANT_URL / QDRANT_API_KEY del backend/.env
# CHROMA_BACKUP_PATH=                 # default: BACKUP_DIR/chroma
# QDRANT_BACKUP_COLLECTIONS=veterinary_reports   # o * para todas
# BATCH_SIZE=100
